ue,"removed":false},{"id":"Fuente","displayName":"Fuente","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"fecha creacion","displayName":"fecha creacion","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[160,432],"id":"ce58abb2-9559-47d7-9e3d-5da3b7698e64","name":"Append row in sheet","credentials":{"googleSheetsOAuth2Api":{"id":"YO9NABMbvs9H6Xgj","name":"Google Sheets account"}}},{"parameters":{"jsCode":"// Normalizar datos de ambos webhooks\nconst body = $input.first().json.body;\n\n// Detectar fuente del formulario\n// Formato nuevo Elementor: fields[name][value], fields[email][value], etc.\nconst isElementorNew = body[\"fields[name][value]\"] !== undefined || body[\"form[name]\"] !== undefined;\n// Formato antiguo Elementor: 👨🏻‍💼 Nombre, ✉︎ E-mail, etc.\nconst isElementorOld = body[\"👨🏻‍💼 Nombre\"] !== undefined;\n// Formato Lovable: nombre, apellidos, email, etc.\nconst isLovable = body.nombre !== undefined;\n// Formato Clínica Zen web (campos en inglés)\nconst isClinicaZen = body.firstName !== undefined;\n\n// Extraer datos según la fuente\nlet nombre, apellidos, telefono, email, mensaje, fuente;\n\nif (isElementorNew) {\n  // Webhook3 - Elementor NUEVO formato (WordPress)\n  nombre = body[\"fields[name][value]\"] || body[\"fields[name][raw_value]\"] || '';\n  apellidos = '';\n  // El teléfono puede venir en diferentes field IDs\n  telefono = body[\"fields[field_17ebf91][value]\"] || \n             body[\"fields[phone][value]\"] || \n             body[\"fields[tel][value]\"] || '';\n  email = body[\"fields[email][value]\"] || body[\"fields[email][raw_value]\"] || '';\n  mensaje = body[\"fields[message][value]\"] || body[\"fields[message][raw_value]\"] || '';\n  fuente = body[\"form[name]\"] || 'Formulario Elementor';\n  \n} else if (isElementorOld) {\n  // Webhook3 - Elementor ANTIGUO formato\n  nombre = body[\"👨🏻‍💼 Nombre\"] || '';\n  apellidos = '';\n  telefono = body[\"📞 Teléfono\"] || '';\n  email = body[\"✉︎ E-mail \"] || '';\n  mensaje = body[\"💬 Mensaje\"] || '';\n  fuente = body.form_name || 'Formulario Elementor';\n  \n} else if (isLovable) {\n  // Webhook - Lovable\n  nombre = body.nombre || '';\n  apellidos = body.apellidos || '';\n  telefono = body.telefono || '';\n  email = body.email || '';\n  mensaje = body.mensaje || '';\n  fuente = body.fuente || 'Formulario Web';\n  \n} else if (isClinicaZen) {\n  // Clínica Zen - formulario web (campos en inglés)\n  nombre = body.firstName || '';\n  apellidos = body.lastName || '';\n  telefono = body.phone || '';\n  email = body.email || '';\n  mensaje = body.reason || '';\n  fuente = body.source || 'Formulario Web';\n\n} else {\n  // Fallback genérico\n  nombre = body.nombre || body.name || '';\n  apellidos = body.apellidos || body.lastname || '';\n  telefono = body.telefono || body.phone || '';\n  email = body.email || '';\n  mensaje = body.mensaje || body.message || '';\n  fuente = 'Formulario Web';\n}\n\n// Normalizar teléfono a formato +34XXXXXXXXX\nfunction normalizarTelefono(tel) {\n  if (!tel) return '';\n  \n  // Convertir a string y limpiar espacios, guiones, paréntesis\n  let limpio = String(tel).replace(/[\\s\\-\\(\\)\\.]/g, '');\n  \n  // Si ya tiene prefijo internacional completo\n  if (limpio.startsWith('+')) {\n    return limpio;\n  }\n  \n  // Si empieza con 00 (formato internacional alternativo)\n  if (limpio.startsWith('00')) {\n    return '+' + limpio.substring(2);\n  }\n  \n  // Si empieza con 34 (prefijo España sin +)\n  if (limpio.startsWith('34') && limpio.length >= 11) {\n    return '+' + limpio;\n  }\n  \n  // Si es número español (6, 7, 8, 9) sin prefijo - añadir +34\n  if (/^[6789]\\d{8}$/.test(limpio)) {\n    return '+34' + limpio;\n  }\n  \n  // Si no cumple ningún patrón, devolver con +34 por defecto\n  return '+34' + limpio;\n}\n\n// Normalizar nombre (capitalizar primera letra)\nfunction normalizarNombre(str) {\n  if (!str) return '';\n  return str.trim()\n    .toLowerCase()\n    .replace(/(?:^|\\s)\\S/g, char => char.toUpperCase());\n}\n\n// Normalizar email (minúsculas, sin espacios)\nfunction normalizarEmail(str) {\n  if (!str) return '';\n  return str.trim().toLowerCase();\n}\n\nreturn {\n  nombre: normalizarNombre(nombre),\n  apellidos: normalizarNombre(apellidos),\n  nombre_completo: normalizarNombre(nombre + (apellidos ? ' ' + apellidos : '')),\n  telefono: normalizarTelefono(telefono),\n  email: normalizarEmail(email),\n  mensaje: (mensaje || '').trim(),\n  fuente: fuente,\n  fecha_registro: new Date().toISOString()\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-16,-32],"id":"ddcffd86-82c0-4d64-a7e7-19cc63731e32","name":"Normalizar Datos1","onError":"continueErrorOutput"},{"id":"e5028c87-985c-4a36-8c22-570f8bb68536","name":"Build Email HTML","type":"n8n-nodes-base.code","typeVersion":2,"position":[200,300],"parameters":{"mode":"runOnceForAllItems","jsCode":"const d = $('Normalizar Datos1').item.json;\nconst html = `<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"color-scheme\" content=\"light only\" />\n  <title>Solicitud recibida — Clínica Zen</title>\n  <style type=\"text/css\">\n    body { margin:0; padding:0; background-color:#EFECE8; font-family:Arial,Helvetica,sans-serif; }\n    table { border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt; }\n    img { display:block; border:0; height:auto; outline:none; text-decoration:none; }\n    @media only screen and (max-width:620px) {\n      .out