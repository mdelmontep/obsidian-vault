      <tr>\n        <td class=\"hero-cell\" background=\"https://raw.githubusercontent.com/AgentesIAMadrid/email-assets/main/clinica-zen/hero_stripe.jpg\" bgcolor=\"#5E4D41\" height=\"262\" style=\"height:262px;background-image:url('https://raw.githubusercontent.com/AgentesIAMadrid/email-assets/main/clinica-zen/hero_stripe.jpg');background-position:center top;background-repeat:no-repeat;background-size:cover;background-color:#5E4D41;padding:0;\">\n          <!--[if gte mso 9]><v:rect xmlns:v=\"urn:schemas-microsoft-com:vml\" fill=\"true\" stroke=\"false\" style=\"width:620px;height:262px;\"><v:fill type=\"frame\" src=\"https://raw.githubusercontent.com/AgentesIAMadrid/email-assets/main/clinica-zen/hero_stripe.jpg\" color=\"#5E4D41\"/><v:textbox inset=\"0,0,0,0\"><![endif]-->\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" height=\"262\" style=\"height:262px;\">\n            <tr>\n              <td align=\"center\" valign=\"middle\" height=\"262\" style=\"height:262px;vertical-align:middle;padding:0;background-color:transparent;\">\n                <img class=\"hero-logo\" src=\"https://raw.githubusercontent.com/AgentesIAMadrid/email-assets/main/clinica-zen/logo.png\" alt=\"Clínica Zen\" width=\"200\" style=\"display:block;width:200px;max-width:60%;height:auto;margin:0 auto;\" />\n              </td>\n            </tr>\n          </table>\n          <!--[if gte mso 9]></v:textbox></v:rect><![endif]-->\n        </td>\n      </tr>\n      <tr>\n        <td align=\"center\" class=\"inner-pad\" style=\"padding:32px 44px 0 44px;background-color:#ffffff;\">\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n            <tr>\n              <td style=\"width:40px;height:1px;background-color:#D8CFC4;font-size:1px;\">&nbsp;</td>\n              <td style=\"padding:0 12px;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#8B6F5A;letter-spacing:3px;text-transform:uppercase;\">Estética dental y facial</td>\n              <td style=\"width:40px;height:1px;background-color:#D8CFC4;font-size:1px;\">&nbsp;</td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n      <tr>\n        <td align=\"center\" class=\"inner-pad\" style=\"padding:24px 44px 0 44px;background-color:#ffffff;\">\n          <p style=\"font-family:Arial,Helvetica,sans-serif;font-size:10px;color:#A49584;letter-spacing:5px;text-transform:uppercase;font-weight:bold;margin:0 0 10px 0;\">Solicitud recibida</p>\n          <h1 class=\"head-title\" style=\"font-family:Georgia,serif;font-size:42px;font-weight:normal;color:#3D2F26;margin:0;line-height:1.05;letter-spacing:-1px;\">Gracias por <em style=\"font-style:italic;color:#8B6F5A;\">ponerte</em><br/>en contacto.</h1>\n        </td>\n      </tr>\n      <tr>\n        <td align=\"center\" class=\"inner-pad\" style=\"padding:18px 56px 0 56px;background-color:#ffffff;\">\n          <p style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.7;color:#67584C;margin:0;\">Hola, <strong style=\"color:#3D2F26;\">${d.nombre}</strong>. Hemos recibido tu solicitud y nos pondremos en contacto contigo en breve.</p>\n        </td>\n      </tr>\n      <tr>\n        <td class=\"inner-pad\" style=\"padding:24px 44px 0 44px;background-color:#ffffff;\">\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#F7F4F0;border-radius:2px;border-left:3px solid #8B6F5A;\">\n            <tr><td class=\"data-body\" style=\"padding:24px 28px;\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr><td><div style=\"padding:0;\"><p style=\"font-family:Arial,Helvetica,sans-serif;font-size:10px;color:#A49584;letter-spacing:3px;text-transform:uppercase;font-weight:bold;margin:0 0 4px 0;\">Nuestra dirección</p><p style=\"font-family:Georgia,serif;font-size:20px;color:#3D2F26;margin:0;line-height:1.25;\">Calle Castillo de Atienza, 1 bis<br/><span style=\"font-style:italic;color:#8B6F5