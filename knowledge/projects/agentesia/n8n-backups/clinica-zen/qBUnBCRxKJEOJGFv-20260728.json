tr><tr><td style=\"border-top:1px solid #E5DED3;\"><div style=\"padding:14px 0 0 0;\"><p style=\"font-family:Arial,Helvetica,sans-serif;font-size:10px;color:#A49584;letter-spacing:3px;text-transform:uppercase;font-weight:bold;margin:0 0 4px 0;\">Nuestra clínica</p><p style=\"font-family:Georgia,serif;font-size:20px;color:#3D2F26;margin:0;line-height:1.25;\">Calle Castillo de Atienza, 1 bis<br/><span style=\"font-style:italic;color:#8B6F5A;font-size:15px;\">Las Rozas de Madrid</span></p></div></td></tr></table>\n            </td></tr>\n          </table>\n        </td>\n      </tr>\n      \n      <tr>\n        <td align=\"center\" style=\"padding:24px 44px 8px 44px;background-color:#ffffff;\">\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n            <td align=\"center\" style=\"border-radius:50px;background-color:#3D2F26;\">\n              <a href=\"https://maps.app.goo.gl/XJ9pnc8qG6Tuqpi89\" target=\"_blank\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;color:#EFECE8;text-decoration:none;padding:16px 34px;display:inline-block;letter-spacing:1px;text-transform:uppercase;\">Cómo llegar &nbsp;&rarr;</a>\n            </td>\n          </tr></table>\n        </td>\n      </tr>\n      <tr>\n        <td align=\"center\" style=\"padding:10px 44px 4px 44px;background-color:#ffffff;\">\n          <p style=\"font-family:Arial,Helvetica,sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:bold;color:#A49584;margin:0;\">\n            <a href=\"tel:+34916401575\" style=\"color:#5E4D41;text-decoration:none;border-bottom:1px solid #D8CFC4;padding-bottom:2px;\">Llamar a la clínica</a><br/><span style=\"color:#A49584;font-size:10px;letter-spacing:1px;\">+34 916 401 575</span>\n          </p>\n        </td>\n      </tr>\n      <tr>\n        <td align=\"center\" style=\"padding:30px 56px 24px 56px;background-color:#ffffff;\">\n          <p style=\"font-family:Georgia,serif;font-size:19px;font-style:italic;color:#8B6F5A;line-height:1.5;margin:0;\">&ldquo;Cuidamos sonrisas<br/>como se cuidan las cosas bellas:<br/>con tiempo y con calma.&rdquo;</p>\n        </td>\n      </tr>\n      <tr>\n        <td align=\"center\" class=\"footer-pad\" style=\"background-color:#3D2F26;padding:36px 44px;\">\n          <p style=\"font-family:Georgia,serif;font-size:28px;font-style:italic;color:#EFECE8;margin:0;letter-spacing:0.5px;\">Clínica Zen</p>\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:12px 0;\">\n            <tr>\n              <td style=\"width:28px;height:1px;background-color:#8B6F5A;font-size:1px;\">&nbsp;</td>\n              <td style=\"padding:0 10px;font-family:Georgia,serif;font-size:10px;color:#A49584;\">&diams;</td>\n              <td style=\"width:28px;height:1px;background-color:#8B6F5A;font-size:1px;\">&nbsp;</td>\n            </tr>\n          </table>\n          <p style=\"font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#A49584;letter-spacing:1px;margin:0 0 6px 0;\">Calle Castillo de Atienza, 1 bis &middot; Las Rozas de Madrid</p>\n          <p style=\"margin:0;\"><a href=\"https://clinicazen.es\" target=\"_blank\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#EFECE8;text-decoration:none;font-weight:bold;letter-spacing:2px;text-transform:uppercase;border-bottom:1px solid #8B6F5A;padding-bottom:2px;\">www.clinicazen.es</a></p>\n          <p style=\"font-family:Arial,Helvetica,sans-serif;font-size:10px;color:#8B6F5A;letter-spacing:2px;text-transform:uppercase;margin:18px 0 0 0;line-height:1.7;\">Este correo se generó automáticamente<br/>al asignar tu especialista.</p>\n        </td>\n      </tr>\n    </table>\n    <!--[if mso]></td></tr></table><![endif]-->\n  </center>\n</body>\n</html>`;\nreturn [{ json: { html } }];"},"id":"972aa428-dd79-4336-8ad9-ecf36c246035","name":"Build Email HTML","type":"n8n-nodes-base.code","typeVersion":2,"position":[-208,512]}],"connections":{"Webhook":{"mai