r el campo \"email\"\n      const email = customFields.find(\n        field => field.field_name === \"Email\"\n      );\n      \n      if (diaPreferencia) {\n        const timestamp = diaPreferencia.values[0]?.value;\n        \n        // Crear fecha de inicio desde timestamp Unix (ya está en UTC)\n        const fechaInicio = new Date(timestamp * 1000);\n        \n        // Crear fecha de fin (1 hora después)\n        const fechaFin = new Date(fechaInicio.getTime() + (60 * 60 * 1000));\n        \n        const doctor = doctorAsignado?.values[0]?.value || null;\n        \n        // Formatear fechas en zona horaria de Madrid\n        const opcionesFecha = {\n          timeZone: 'Europe/Madrid',\n          year: 'numeric',\n          month: '2-digit',\n          day: '2-digit',\n          hour: '2-digit',\n          minute: '2-digit',\n          second: '2-digit',\n          hour12: false\n        };\n        \n        const opcionesFechaLarga = {\n          timeZone: 'Europe/Madrid',\n          dateStyle: 'full',\n          timeStyle: 'long'\n        };\n        \n        // Agregar resultado en formato n8n\n        results.push({\n          json: {\n            leadId: lead.id,\n            leadName: lead.name,\n            email: email?.values[0]?.value || null,\n            diaPreferenciaTimestamp: timestamp,\n            startDate: fechaInicio.toISOString(), // UTC para sistemas externos\n            endDate: fechaFin.toISOString(), // UTC para sistemas externos\n            diaPreferenciaFechaFormateada: fechaInicio.toLocaleString('es-ES', opcionesFecha),\n            diaPreferenciaFechaLarga: fechaInicio.toLocaleString('es-ES', opcionesFechaLarga),\n            doctorAsignado: doctor,\n            // Campos adicionales para depuración en zona Madrid\n            timestampOriginal: timestamp,\n            fechaInicioMadrid: fechaInicio.toLocaleString('es-ES', opcionesFecha),\n            fechaFinMadrid: fechaFin.toLocaleString('es-ES', opcionesFecha),\n        