{"updatedAt":"2026-05-18T23:01:52.725Z","createdAt":"2026-05-18T22:41:30.598Z","id":"ijmJzPmmokLAPX3G","name":"Reembed Tecnocloud Documents","description":"One-shot: re-embebe los 63 chunks de Tecnocloud con text-embedding-3-small. Itera documents_reembed_queue, llama OpenAI embeddings, actualiza embedding en documents y marca done_at. Archivar tras verificar remaining=0.","active":false,"isArchived":true,"nodes":[{"id":"c8ea2681-e0de-47e7-8a5d-e8b2f2687e9a","name":"Start Reembed","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[240,300]},{"id":"6b095433-f586-474e-9a09-f5e4ccc7edde","name":"Get Pending Rows","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[480,300],"parameters":{"operation":"executeQuery","query":"SELECT q.id, d.text FROM public.documents_reembed_queue q JOIN public.documents d ON d.id = q.id WHERE q.done_at IS NULL ORDER BY q.id","options":{}},"credentials":{"postgres":{"id":"knkhDOsSYqDP8tTx","name":"Postgres Tecnocloud"}}},{"id":"bdab214e-82c2-4194-8192-e143dbb856a7","name":"Verify Complete","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[960,160],"parameters":{"operation":"executeQuery","query":"SELECT count(*) AS remaining FROM public.documents_reembed_queue WHERE done_at IS NULL","options":{}},"credentials":{"postgres":{"id":"knkhDOsSYqDP8tTx","name":"Postgres Tecnocloud"}}},{"id":"f08eb60c-43ed-4c91-b794-798c91bb1787","name":"Call OpenAI Embeddings","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[960,300],"parameters":{"method":"POST","url":"https://api.openai.com/v1/embeddings","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={\"model\":\"text-embedding-3-small\",\"input\":{{ JSON.stringify($json.text) }}}","options":{"timeout":15000}},"credentials":{"httpHeaderAuth":{"id":"wE4PHugQYoq9wGJh","name":"Openai"}}},{"id":"3a985e6f-72a8-4ea6-8a46-2fdc3c9abd41","name":"Prepare SQL","type":"n8n-nodes-base.code","typeVersion":2,"position":[1180,300],"parameters":{"mode":"runOnceForAllItems","jsCode":"const id = $('Loop Rows').first().json.id;\nconst emb = $('Call OpenAI Embeddings').first().json.data[0].embedding;\nconst embStr = '[' + emb.join(',') + ']';\nreturn [{\n  json: {\n    updateSQL: 'UPDATE public.documents SET embedding = $1::vector WHERE id = ' + id,\n    markSQL: 'UPDATE public.documents_reembed_queue SET done_at = now() WHERE id = ' + id,\n    embStr: embStr\n  }\n}];"}},{"id":"28cad6ba-b19a-44c3-a24c-9515a61782f7","name":"Update Embedding","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1400,300],"parameters":{"operation":"executeQuery","query":"={{ $(\"Prepare SQL\").first().json.updateSQL }}","options":{"queryReplacement":"={{ $(\"Prepare SQL\").first().json.embStr }}"}},"credentials":{"postgres":{"id":"knkhDOsSYqDP8tTx","name":"Postgres Tecnocloud"}}},{"id":"b2ce9a8a-b768-471d-a259-55a91ddd7113","name":"Mark Done","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1620,300],"parameters":{"operation":"executeQuery","query":"={{ $(\"Prepare SQL\").first().json.markSQL }}","options":{}},"credentials":{"postgres":{"id":"knkhDOsSYqDP8tTx","name":"Postgres Tecnocloud"}}},{"id":"03303171-f1f2-4474-aeeb-d41daf863beb","name":"Loop Rows","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[720,300],"parameters":{"batchSize":1}}],"connections":{"Start Reembed":{"main":[[{"node":"Get Pending Rows","type":"main","index":0}]]},"Get Pending Rows":{"main":[[{"node":"Loop Rows","type":"main","index":0}]]},"Call OpenAI Embeddings":{"main":[[{"node":"Prepare SQL","type":"main","index":0}]]},"Prepare SQL":{"main":[[{"node":"Update Embedding","type":"main","index":0}]]},"Update Embedding":{"main":[[{"node":"Mark Done","type":"main","index":0}]]},"Mark Done":{"main":[[{"node":"Loop Rows","type":"main","index":0}]]},"Loop Rows":{"main":[[{"node":"Verify Complete","type":"main","index":0}],[{"node":"Call OpenAI Embed